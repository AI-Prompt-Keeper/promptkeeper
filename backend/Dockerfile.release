# Production image for Fly.io: multi-stage Rust build, minimal runtime.
# Build context: backend/ (this directory). Deploy: cd backend && fly deploy.
# Usage: fly deploy with fly.toml in this directory.

# --- Builder ---
FROM rust:1-bookworm AS builder
WORKDIR /app

# Cache dependencies: copy manifests and dummy source, then build
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs \
    && cargo build --release \
    && rm -rf src

# Build real binary
COPY src ./src
RUN touch src/main.rs && cargo build --release

# --- Runtime ---
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/promptkeeper .

EXPOSE 3000
CMD ["./promptkeeper"]
